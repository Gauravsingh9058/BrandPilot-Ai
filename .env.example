# ==============================================================================
# VidSnapAI - Local Development Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: CORE APPLICATION & SERVERS (Development Defaults)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=
WEB_BASE_URL=

# ------------------------------------------------------------------------------
# SECTION 2: DATABASE & CACHE (Required for Local App to Run)
# ------------------------------------------------------------------------------
# Canonical PostgreSQL Connection String (Matching Docker Compose service)
DATABASE_URL=

# Redis Connection String (For Cache, Sessions & BullMQ Queue processing)
REDIS_URL=

# ------------------------------------------------------------------------------
# SECTION 3: AUTHENTICATION & SECURITY (Required for Local App to Run)
# ------------------------------------------------------------------------------
# Session Secret (Must be at least 32 characters long)
SESSION_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=

# ------------------------------------------------------------------------------
# SECTION 4: STORAGE & MEDIA PROVIDERS (Development Defaults / Local Providers)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=
STORAGE_BUCKET=
VOICE_PROVIDER=

# ------------------------------------------------------------------------------
# SECTION 5: EXTERNAL AI & MEDIA API KEYS (Optional for local startup / Required when using live features)
# ------------------------------------------------------------------------------
# Google Gemini API Key & Model (Required for live AI generation)
GEMINI_API_KEY=
GEMINI_MODEL=

# Pexels API Key (Required for live stock video/image search)
PEXELS_API_KEY=
